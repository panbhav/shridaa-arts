PORT=3000
ADMIN_USERNAME=admin
# Run npm run setup to generate private values. Never commit .env.
ADMIN_PASSWORD=
JWT_SECRET=
# Optional bcrypt hash instead of ADMIN_PASSWORD
ADMIN_PASSWORD_HASH=
# Persistent folder for catalogue, uploads, backups and enquiry inbox (one server instance).
# STORAGE_DIR=D:/ShridaaStorage
# Optional server-to-server notification integration; inbox works without it.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
